# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BytePress"

# Database: Neon PostgreSQL
DATABASE_URL="postgresql://username:password@ep-example-region.neon.tech/bytepress?sslmode=require"

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Optional OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Usage limits
ANONYMOUS_DAILY_LIMIT="5"
USER_DAILY_LIMIT="25"
MAX_UPLOAD_SIZE_MB="50"

# File processing
TEMP_FILE_TTL_MINUTES="30"
PROCESSING_MODE="hybrid"
LOCAL_TEMP_DIR="./tmp/uploads"

# Worker/API settings for server-side conversions
WORKER_BASE_URL="http://localhost:4000"
WORKER_API_KEY="replace-with-worker-api-key"

# Email provider for account and password emails
EMAIL_FROM="BytePress <hello@princepatel.me>"
RESEND_API_KEY=""
